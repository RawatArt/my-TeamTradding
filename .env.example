# M9 continuous observation remains SHADOW-only and disabled by default.
APP_MODE=SHADOW
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACKNOWLEDGED=false
LOG_LEVEL=INFO
LOG_JSON=true

# Configure the exact broker-specific symbol used for the optional M1 integration test.
# TRADING_SYMBOL=

# M1 read-only MetaTrader 5 connection. A complete LOGIN/PASSWORD/SERVER set is required when
# explicit authentication is used. Otherwise the client uses the terminal's current session.
# Never commit real values.
# MT5__TERMINAL_PATH=C:\Program Files\MetaTrader 5\terminal64.exe
# MT5__LOGIN=
# MT5__PASSWORD=
# MT5__SERVER=
MT5__TIMEOUT_MS=60000
MT5__PORTABLE=false

# Terminal integration is opt-in and skipped by default.
RUN_MT5_INTEGRATION=false

# M2 immutable MarketSnapshot composition and descriptive freshness thresholds.
MARKET_DATA__M15_CANDLE_COUNT=200
MARKET_DATA__H1_CANDLE_COUNT=200
MARKET_DATA__H4_CANDLE_COUNT=200
MARKET_DATA__MAX_TICK_AGE_SECONDS=120
MARKET_DATA__MAX_ACCOUNT_AGE_SECONDS=30
MARKET_DATA__MAX_M15_CANDLE_AGE_SECONDS=1800
MARKET_DATA__MAX_H1_CANDLE_AGE_SECONDS=7200
MARKET_DATA__MAX_H4_CANDLE_AGE_SECONDS=28800
MARKET_DATA__SLOW_SNAPSHOT_SECONDS=30

# Risk-constitution values are percentage points, not binary float fractions.
RISK__STARTING_BALANCE=50
RISK__MINIMUM_RISK_PERCENT=0.25
RISK__NORMAL_RISK_PERCENT=0.50
RISK__MAXIMUM_RISK_PERCENT=1.00
RISK__MAXIMUM_OPEN_POSITIONS=1
RISK__MAXIMUM_DAILY_LOSS_PERCENT=3
RISK__DRAWDOWN_WARNING_PERCENT=5
RISK__DRAWDOWN_SAFE_MODE_PERCENT=8
RISK__DRAWDOWN_STOP_PERCENT=15
RISK__MINIMUM_RISK_REWARD=1.50
RISK__STOP_LOSS_REQUIRED=true
RISK__MARTINGALE_ENABLED=false
RISK__AVERAGING_DOWN_ENABLED=false
RISK__REVENGE_TRADING_ENABLED=false

# Inert M4 debate-policy limit; M4 does not invoke any model.
AGENTS__MAX_DEBATE_ROUNDS=1

# M5 never invokes a provider during application startup. Provider smoke tests are separately
# opt-in, and each provider must pass its own live smoke acceptance before later runtime use.
LLM__ENABLED=false
LLM__BUDGET_DATABASE_PATH=data/ai_budget.sqlite3
# LLM__OPENAI_API_KEY=
# LLM__ANTHROPIC_API_KEY=
# LLM__GEMINI_API_KEY=
RUN_OPENAI_SMOKE=false
RUN_ANTHROPIC_SMOKE=false
RUN_GEMINI_SMOKE=false

# M6 does not schedule cycles automatically. Real-provider shadow acceptance is separately opt-in
# and also requires a matching non-secret provider acceptance registry entry.
SHADOW__ENABLED=false
SHADOW__AUDIT_DATABASE_PATH=data/shadow_audit.sqlite3
SHADOW__PROVIDER_ACCEPTANCE_PATH=config/provider_acceptance.toml
SHADOW__QUANT_STAGE_SELECTION=SKIP
RUN_M6_PROVIDER_SHADOW=false

# M7 calculations are explicit and inert; these values are included in provenance digests.
FEATURES__RECENT_RANGE_LOOKBACK=20
FEATURES__SWING_LEFT_BARS=2
FEATURES__SWING_RIGHT_BARS=2

# M8 offline replay remains inert and requires APP_MODE=BACKTEST when explicitly enabled.
REPLAY__ENABLED=false
REPLAY__REPOSITORY_PATH=data/replay.sqlite3

# M9 is explicitly polled; application startup does not begin a background scheduler.
CONTINUOUS_SHADOW__ENABLED=false
CONTINUOUS_SHADOW__POLL_INTERVAL_SECONDS=5
CONTINUOUS_SHADOW__DISCOVERY_LOOKBACK=4
CONTINUOUS_SHADOW__MAXIMUM_DECISION_AGE_SECONDS=180
CONTINUOUS_SHADOW__MAXIMUM_PENDING_CYCLES=1
CONTINUOUS_SHADOW__SHUTDOWN_GRACE_SECONDS=30
CONTINUOUS_SHADOW__REPOSITORY_PATH=data/continuous_shadow.sqlite3
CONTINUOUS_SHADOW__SYMBOL_ACCEPTANCE_PATH=config/symbol_timestamp_acceptance.toml
CONTINUOUS_SHADOW__PROVIDER_ACCEPTANCE_PATH=config/continuous_shadow_acceptance.toml
