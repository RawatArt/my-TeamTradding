# M0 is a non-trading architecture milestone. SHADOW is the safe default.
APP_MODE=SHADOW
ENABLE_LIVE_TRADING=false
LIVE_TRADING_ACKNOWLEDGED=false
LOG_LEVEL=INFO
LOG_JSON=true

# Configure a broker-specific symbol only when a later milestone requires it.
# TRADING_SYMBOL=

# Risk-constitution values are percentage points, not binary float fractions.
RISK__STARTING_BALANCE=50
RISK__MINIMUM_RISK_PERCENT=0.25
RISK__NORMAL_RISK_PERCENT=0.50
RISK__MAXIMUM_RISK_PERCENT=1.00
RISK__MAXIMUM_OPEN_POSITIONS=1
RISK__MAXIMUM_DAILY_LOSS_PERCENT=3
RISK__DRAWDOWN_WARNING_PERCENT=5
RISK__DRAWDOWN_SAFE_MODE_PERCENT=8
RISK__DRAWDOWN_STOP_PERCENT=15
RISK__MINIMUM_RISK_REWARD=1.50
RISK__STOP_LOSS_REQUIRED=true
RISK__MARTINGALE_ENABLED=false
RISK__AVERAGING_DOWN_ENABLED=false
RISK__REVENGE_TRADING_ENABLED=false

# Future secrets belong only in an ignored .env or approved secret store.
# Never put real values in this example file.
# OPENAI_API_KEY=
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=

